# PORT Configuration
PORT=3000

# WEBHOOK Configuration
# Set to your tunnel URL (e.g., https://your-tunnel.ngrok.io or https://your-tunnel.cloudflare.com)
# This is used to tell Meta where to send WhatsApp webhook callbacks
WEBHOOK_PUBLIC_URL=

# WhatsApp Meta Configuration
# Get from: https://business.facebook.com/ → WhatsApp Business → Settings
META_VERIFY_TOKEN=your_meta_verify_token_here
META_ACCESS_TOKEN=your_meta_access_token_here
META_PHONE_NUMBER_ID=your_meta_phone_number_id_here

# Gemini API Configuration
# Get from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration
# Get from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# Cloudflare R2 Configuration (for image storage)
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=your_bucket_name_here
R2_PUBLIC_URL=https://your-r2-public-url.r2.dev

# Redis Configuration (for BullMQ task queue)
REDIS_URL=redis://localhost:6379

# Admin/Test Configuration
ADMIN_PHONE=your_admin_phone_here
TEST_PHONE=your_test_phone_here

# Google Search Configuration (for price monitoring)
GOOGLE_CSE_KEY=your_google_cse_key_here
GOOGLE_CSE_ID=your_google_cse_id_here