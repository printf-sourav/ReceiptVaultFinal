# Supabase Configuration
# Get these from: https://supabase.com/dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-supabase-url.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend API Configuration (for OTP and receipt upload)
# Use your tunnel URL in production (e.g., https://your-tunnel.ngrok.io)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google OAuth Configuration (for web only)
# Optional: Get from https://console.cloud.google.com/
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Use localhost for simulator, remove for device builds
EXPO_PUBLIC_USE_LOCALHOST=true
